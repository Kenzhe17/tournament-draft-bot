ORG_ROLE_MAP=

# Tournament channels for organizer management (comma-separated list)
TOURNAMENT_CHANNELS=

# Единый канал карточек «НАЙДЕН МАТЧ» (0 = первый TOURNAMENT_CHANNELS)
MATCH_FOUND_CHANNEL_ID=

# Пул каналов MM-матчей (csv)
MM_MATCH_CHANNEL_POOL=

# Notification role/channel for tournament announcements
NOTIFICATION_ROLE_ID=
NOTIFICATION_CHANNEL_ID=

# Moderation logging webhook — СЕКРЕТ, только через env (пусто = выкл)
MOD_LOG_WEBHOOK_URL=
MOD_LOG_CHANNEL_ID=

# Battle Royale settings
BR_ROLE_ID=
BR_ROOM_CHANNEL_ID=
BR_DATA_CHANNEL_ID=
BR_TEAM_CHANNEL_ID=

# OCR: канал итогов матчей, канал статистики, роль пинга админов
OCR_RESULT_CHANNEL_ID=
OCR_STATS_CHANNEL_ID=
# Канал OCR-скриншотов/сопоставления для обычных турниров
# (MM-матчи публикуют OCR в канале матча)
OCR_MAPPING_CHANNEL_ID=
OCR_ADMIN_ROLE_ID=
# Fast anchor-based OCR для CS 4×4 (1 = вкл, 0 = только полный RapidOCR)
OCR_FAST_ENABLED=1
# ONNX Runtime threads (-1 = все ядра). На слабом CPU Railway
# попробовать 1 или 2, если det/rec стадий тормозят.
OCR_INTRA_OP_THREADS=-1
OCR_INTER_OP_THREADS=-1
FAST_DET_THREADS=-1

# Ultimatum: роль участников и канал данных комнат
ULT_ROLE_ID=
ULT_ROOM_CHANNEL_ID=

# Прочие серверные каналы
WELCOME_CHANNEL_ID=
PET_HUNGER_CHANNEL_ID=
ROOM_DATA_CHANNEL_ID=
GAMES_CHANNEL_ID=
INFO_CHANNEL_ID=
REP_LOG_CHANNEL_ID=


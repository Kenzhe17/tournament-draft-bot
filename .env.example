DISCORD_TOKEN=your_discord_bot_token_here
DATABASE_URL=
BOT_OWNER_ID=

# --- Изоляция серверов (prod vs test) ---
# ID гильдии, для которой работает этот экземпляр бота.
# 0/пусто = без привязки. Тестовый бот: ID тестового сервера.
GUILD_ID=
# Если задано (csv) — бот обрабатывает события ТОЛЬКО этих гильдий
# и покидает чужие при приглашении. Тестовый бот: ID тест-сервера.
ALLOWED_GUILD_IDS=
# Дополнительные админ/организатор ID (csv), помимо BOT_OWNER_ID.
# Production: 1032544122600423427,582145013358657549,575937439147753472
EXTRA_ADMIN_USER_IDS=

# Log channel ID for tournament events
LOG_CHANNEL_ID=

# Organizer role ID
ORG_ROLE_ID=

# Manager role ID (for channel organizer management)
MANAGER_ROLE_ID=

# Tournament organizer roles (one per channel)
ORG_1_ROLE_ID=
ORG_2_ROLE_ID=
ORG_3_ROLE_ID=

# Соответствие канал организаторов → роль (csv "channel_id:role_id")

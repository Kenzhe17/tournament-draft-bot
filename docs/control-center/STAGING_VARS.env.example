# === bot-staging (Railway service variables) ===
DISCORD_TOKEN=<staging-bot-token — НЕ production>
DATABASE_URL=<staging-postgres-url>
REDIS_URL=<staging-redis-url>          # если используется
BOT_OWNER_ID=<owner-discord-id>
ALLOWED_GUILD_IDS=<test-guild-id>
GUILD_ID=<test-guild-id>
TOURNAMENT_AUDIT_CHANNEL_ID=<audit-channel-id>   # 1571226820593061980 для prod
MM_ENABLED=0                            # скрыть MM в staging/prod по готовности
# + ID каналов/ролей ТЕСТОВОГО сервера (см. config.py)

# === panel (Railway service variables) ===
SERVICE_ROLE=panel
CONTROL_CENTER_PUBLIC_URL=https://<panel-domain>
CONTROL_CENTER_DISCORD_CLIENT_ID=<staging-app-client-id>
CONTROL_CENTER_DISCORD_CLIENT_SECRET=<staging-app-secret>
CONTROL_CENTER_SESSION_SECRET=<random-64-chars>
CONTROL_CENTER_OWNER_IDS=<owner-discord-id>
CONTROL_CENTER_GUILD_ID=<test-guild-id>
CONTROL_CENTER_COOKIE_SECURE=true
DATABASE_URL=<та же staging-БД>
# OAuth2 redirect в Discord Dev Portal: {PUBLIC_URL}/auth/callback
